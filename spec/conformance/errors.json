{
  "name": "errors are typed",
  "setup": [
    "create table acct (id int primary key, bal int not null)",
    "insert into acct values (1, 10)",
    "select gnomon.track('acct')"
  ],
  "steps": [
    {"call": "startRun", "args": {"task": "errors"}},
    {"call": "run.sql", "args": {"statement": "insert into acct values (1, 5) on conflict (id) do update set bal = excluded.bal"}, "expect": {"error": "UnsupportedOnBranchError", "sqlOnly": true}},
    {"call": "run.sql", "args": {"statement": "select pg_sleep(3)"}, "options": {"timeoutMs": 300}, "expect": {"error": "StatementTimeoutError"}},
    {"call": "run.discard"},
    {"call": "run.sql", "args": {"statement": "select 1"}, "expect": {"error": "GnomonError"}}
  ]
}
