{
  "name": "a run writes its branch, the app sees the diff, merges, and main changes",
  "setup": [
    "create table item (id int generated by default as identity primary key, name text not null, qty int not null default 0)",
    "insert into item (name, qty) select 'item ' || g, g from generate_series(1, 5) g",
    "select gnomon.track('item')"
  ],
  "steps": [
    {
      "call": "startRun",
      "args": {
        "task": "rename item 2",
        "actor": "bot"
      }
    },
    {
      "call": "run.sql",
      "args": {
        "statement": "update item set name = 'renamed' where id = 2"
      },
      "expect": {
        "rowCount": 1
      }
    },
    {
      "call": "run.sql",
      "args": {
        "statement": "insert into item (name) values ('new')"
      },
      "expect": {
        "rowCount": 1
      }
    },
    {
      "call": "run.sql",
      "args": {
        "statement": "select name from item where id = 2"
      },
      "expect": {
        "rows": [
          {
            "name": "renamed"
          }
        ]
      }
    },
    {
      "call": "app.sql",
      "args": {
        "statement": "select name from item where id = 2"
      },
      "expect": {
        "rows": [
          {
            "name": "item 2"
          }
        ]
      }
    },
    {
      "call": "run.diff",
      "expect": {
        "length": 2
      }
    },
    {
      "call": "run.summary",
      "expect": {
        "changes.rows": 2
      }
    },
    {
      "call": "run.sql",
      "args": {
        "statement": "select 1; select 2"
      },
      "expect": {
        "error": "GnomonError"
      }
    },
    {
      "call": "run.sql",
      "args": {
        "statement": "update public.item set qty = 0"
      },
      "expect": {
        "error": "PermissionError",
        "sqlOnly": true
      },
      "note": "SQL core: a schema-qualified name reaches main's table and is refused. With the C module, qualified names are routed to the branch (the write lands on the run's branch, main is unchanged)."
    },
    {
      "call": "run.sql",
      "args": {
        "statement": "select gnomon.merge('main')"
      },
      "expect": {
        "error": "GnomonError"
      }
    },
    {
      "call": "run.merge"
    },
    {
      "call": "app.sql",
      "args": {
        "statement": "select name from item where id = 2"
      },
      "expect": {
        "rows": [
          {
            "name": "renamed"
          }
        ]
      }
    }
  ]
}
